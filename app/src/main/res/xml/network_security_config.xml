<?xml version="1.0" encoding="utf-8"?>
<!-- Media servers on a home network are usually plain http (http://192.168.1.10:32400,
     http://nas:8096), so cleartext is allowed. Sign-in to plex.tv is always https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
